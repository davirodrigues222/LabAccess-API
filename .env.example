DATABASE_URL=postgresql://postgres:SENHA@localhost:5432/labaccess
WEATHER_API_KEY=sua_chave_openweather
CIDADE_LABORATORIO=Fortaleza
UMIDADE_MAXIMA=80
PORT=3000

# mTLS (gerados por: npm run certs)
TLS_KEY_PATH=./certs/server.key
TLS_CERT_PATH=./certs/server.crt
TLS_CA_PATH=./certs/ca.crt

# Duração da sessão após o login, em minutos (limitada pela validade do certificado)
SESSAO_MINUTOS=60
# Limite global de requisições por minuto, por IP
RATE_LIMIT_POR_MINUTO=120
