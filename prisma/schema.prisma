generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Perfis: PESQUISADOR | TECNICO | ADMIN
model Usuario {
  id                     String   @id @default(uuid())
  nome                   String
  email                  String   @unique
  matricula              String   @unique
  perfil                 String
  // Common Name do certificado X.509 do cliente (informativo)
  certificadoCN          String   @unique
  // Fingerprint SHA-256 do certificado do cliente (AB:CD:...). É o que identifica o usuário no mTLS.
  certificadoFingerprint String?  @unique
  ativo                  Boolean  @default(true)
  createdAt              DateTime @default(now())

  // Relacionamentos
  agendamentos           Agendamento[]
  sessoes                SessaoCertificado[]
}

// "Login" do mTLS: registra que o certificado iniciou uma sessão com prazo de validade.
// O logout apaga a linha; sessão expirada é tratada como não autenticada.
model SessaoCertificado {
  fingerprint String   @id
  usuarioId   String
  expiraEm    DateTime
  criadoEm    DateTime @default(now())

  usuario     Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

// status: DISPONIVEL | MANUTENCAO
model Equipamento {
  id              String       @id @default(uuid())
  nome            String
  patrimonio      String       @unique
  descricao       String
  status          String
  localizacao     String
  categoria       String
  valorEstimado   Float
  // Equipamentos sensíveis têm a reserva bloqueada sob umidade alta (OpenWeather)
  sensivelUmidade Boolean      @default(false)
  createdAt       DateTime     @default(now())

  // Relacionamento
  agendamentos    Agendamento[]
}

// statusAprovacao: PENDENTE | APROVADO | REJEITADO
model Agendamento {
  id                 String      @id @default(uuid())
  usuarioId          String
  equipamentoId      String
  dataInicio         DateTime
  dataFim            DateTime
  finalidade         String
  statusAprovacao    String      @default("PENDENTE")
  observacoesTecnico String?
  // Condições climáticas registradas na criação (OpenWeather)
  umidade            Int?
  temperatura        Float?
  condicaoClimatica  String?
  createdAt          DateTime    @default(now())

  // Relações
  usuario            Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  equipamento        Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Cascade)
}
