{
  "name": "@alchemy.run/node-utils",
  "version": "2.0.0-beta.83",
  "description": "Runtime utilities for Alchemy packages.",
  "keywords": [
    "alchemy",
    "gitignore",
    "node",
    "utilities"
  ],
  "homepage": "https://alchemy.run",
  "bugs": {
    "url": "https://github.com/alchemy-run/alchemy/issues"
  },
  "license": "Apache-2.0",
  "author": "Sam Goodwin <sam@alchemy.run>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alchemy-run/alchemy.git",
    "directory": "packages/node-utils"
  },
  "files": [
    "src",
    "lib",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_LICENSES.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./ignore": {
      "types": "./lib/ignore.d.ts",
      "bun": "./src/ignore.ts",
      "default": "./lib/ignore.js"
    },
    "./register-oxc": {
      "types": "./lib/loader/register.d.ts",
      "bun": "./src/loader/register.ts",
      "default": "./lib/loader/register.js"
    },
    "./watch-import": {
      "types": "./lib/watch/import-watcher.d.ts",
      "bun": "./src/watch/import-watcher.ts",
      "default": "./lib/watch/import-watcher.js"
    },
    "./watch-import-bun": {
      "types": "./lib/watch/bun-import-tracker.d.ts",
      "bun": "./src/watch/bun-import-tracker.ts",
      "default": "./lib/watch/bun-import-tracker.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "rolldown": "1.2.5"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "build": "pnpm -r --filter \"{.}...\" run build:package",
    "build:package": "node scripts/build.ts",
    "test": "bun test ./test"
  }
}