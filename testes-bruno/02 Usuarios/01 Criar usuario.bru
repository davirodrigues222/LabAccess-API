meta {
  name: Criar usuario
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/usuarios
  body: json
  auth: none
}

body:json {
  {
    "nome": "Davi Rodrigues",
    "email": "davi.{{sufixo}}@lab.edu",
    "matricula": "MAT-{{sufixo}}",
    "perfil": "PESQUISADOR",
    "certificadoCN": "davi.rodrigues.{{sufixo}}"
  }
}

script:post-response {
  bru.setVar("usuarioId", res.body.id);
}

tests {
  test("status 201", function() {
    expect(res.status).to.equal(201);
  });
}
