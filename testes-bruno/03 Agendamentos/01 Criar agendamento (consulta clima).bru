meta {
  name: Criar agendamento (consulta clima)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/agendamentos
  body: json
  auth: none
}

body:json {
  {
    "usuarioId": "{{usuarioId}}",
    "equipamentoId": "{{equipamentoId}}",
    "dataInicio": "{{dataInicio}}",
    "dataFim": "{{dataFim}}",
    "finalidade": "Análise de amostras do projeto de pesquisa"
  }
}

script:pre-request {
  const inicio = new Date();
  inicio.setDate(inicio.getDate() + 1);
  inicio.setHours(14, 0, 0, 0);
  const fim = new Date(inicio.getTime() + 2 * 60 * 60 * 1000);
  bru.setVar("dataInicio", inicio.toISOString());
  bru.setVar("dataFim", fim.toISOString());
}

script:post-response {
  if (res.status === 201) bru.setVar("agendamentoId", res.body.id);
}

tests {
  test("status 201,422", function() {
    expect(res.status).to.be.oneOf([201,422]);
  });
  test("201 registra o clima / 422 explica o bloqueio", function() {
    if (res.status === 201) {
      expect(res.body.statusAprovacao).to.equal("PENDENTE");
    } else {
      expect(res.body.clima.umidade).to.be.above(res.body.limiteUmidade);
    }
  });
}

docs {
  201 = reserva criada (umidade/temperatura/condicaoClimatica preenchidos se a WEATHER_API_KEY estiver ativa). 422 = bloqueada por umidade. Para forçar o 422 na apresentação, use UMIDADE_MAXIMA=10 no .env.
}
