meta {
  name: Reserva para 10 dias (sem clima)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/agendamentos
  body: json
  auth: none
}

body:json {
  {
    "usuarioId": "{{usuarioId}}",
    "equipamentoId": "{{equipamentoId}}",
    "dataInicio": "{{inicioLonge}}",
    "dataFim": "{{fimLonge}}",
    "finalidade": "Análise de amostras do projeto de pesquisa"
  }
}

script:pre-request {
  const inicio = new Date();
  inicio.setDate(inicio.getDate() + 10);
  inicio.setHours(9, 0, 0, 0);
  bru.setVar("inicioLonge", inicio.toISOString());
  bru.setVar("fimLonge", new Date(inicio.getTime() + 3600000).toISOString());
}

script:post-response {
  bru.setVar("agendamentoLongeId", res.body.id);
}

tests {
  test("status 201", function() {
    expect(res.status).to.equal(201);
  });
  test("fora do alcance da previsao: sem dados de clima", function() {
    expect(res.body.umidade).to.equal(null);
  });
}
