meta {
  name: Desativar usuario (admin)
  type: http
  seq: 7
}

put {
  url: {{baseUrl}}/usuarios/{{novoUsuarioId}}
  body: json
  auth: none
}

body:json {
  { "ativo": false }
}

script:pre-request {
  bru.setVar("perfil", "admin"); // certificado de cliente usado nesta requisição
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("ficou inativo", function() {
    expect(res.body.ativo).to.equal(false);
  });
}
