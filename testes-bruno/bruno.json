{
  "version": "1",
  "name": "LabAccess API",
  "type": "collection",
  "ignore": [
    "node_modules",
    ".git"
  ],
  "clientCertificates": {
    "enabled": true,
    "certs": [
      {
        "domain": "localhost",
        "type": "cert",
        "certFilePath": "../certs/{{perfil}}.crt",
        "keyFilePath": "../certs/{{perfil}}.key"
      }
    ]
  }
}
