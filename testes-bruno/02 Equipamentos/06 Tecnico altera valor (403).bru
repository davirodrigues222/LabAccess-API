meta {
  name: Tecnico altera valor (403)
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/equipamentos/{{equipamentoId}}
  body: json
  auth: none
}

body:json {
  { "valorEstimado": 1 }
}

script:pre-request {
  bru.setVar("perfil", "tecnico"); // certificado de cliente usado nesta requisição
}

tests {
  test("status 403", function() {
    expect(res.status).to.equal(403);
  });
}

docs {
  O técnico só pode alterar o campo status (ex.: colocar em manutenção).
}
