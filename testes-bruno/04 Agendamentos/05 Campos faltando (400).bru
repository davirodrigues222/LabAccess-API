meta {
  name: Campos faltando (400)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/agendamentos
  body: json
  auth: none
}

body:json {
  { "equipamentoId": "{{equipamentoId}}" }
}

script:pre-request {
  bru.setVar("perfil", "pesquisador"); // certificado de cliente usado nesta requisição
}

tests {
  test("status 400", function() {
    expect(res.status).to.equal(400);
  });
}
