meta {
  name: 09 Tecnico aprova a reserva
  type: http
  seq: 9
}

put {
  url: {{comoTecnico}}/agendamentos/{{demoAgendamentoId}}
  body: json
  auth: none
}

body:json {
  {
    "statusAprovacao": "APROVADO",
    "observacoesTecnico": "Liberado. Usar ponteira x10."
  }
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("reserva aprovada", function() {
    expect(res.body.statusAprovacao).to.equal("APROVADO");
  });
}
