meta {
  name: Login pesquisador
  type: http
  seq: 6
}

post {
  url: {{comoPesquisador}}/auth/login
  body: none
  auth: none
}

script:post-response {
  bru.setVar("pesquisadorId", res.body.usuario.id);
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("certificado identifica o perfil PESQUISADOR", function() {
    expect(res.body.usuario.perfil).to.equal("PESQUISADOR");
  });
}
