meta {
  name: Quem sou eu
  type: http
  seq: 7
}

get {
  url: {{comoPesquisador}}/auth/me
  body: none
  auth: none
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("dados do certificado", function() {
    expect(res.body.certificado.cn).to.equal("pesquisador");
    expect(res.body.certificado.fingerprint).to.be.a("string");
  });
}
